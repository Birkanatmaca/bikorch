{
  "name": "ai-dev-workspace",
  "productName": "Bikorch",
  "version": "0.1.1",
  "description": "Bikorch — multi-CLI desktop workspace orchestrator",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "clean:release": "rm -rf release",
    "dist:mac": "npm run clean:release && npm run build && electron-builder --mac && node -e \"const fs=require('fs');const path=require('path');const root='release';if(!fs.existsSync(root))process.exit(0);for(const name of fs.readdirSync(root)){if(name==='Bikorch.dmg')continue;fs.rmSync(path.join(root,name),{recursive:true,force:true})}\"",
    "dist:win": "npm run clean:release && npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke:webchat": "electron scripts/webchat-lifecycle-smoke.cjs"
  },
  "build": {
    "appId": "com.bikorch.app",
    "productName": "Bikorch",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": null,
    "removePackageScripts": true,
    "files": [
      "out/**/*",
      "app-logo.png",
      "build/icon.icns"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSUserNotificationsUsageDescription": "Bikorch notifies you when a CLI task finishes or fails.",
        "NSUserNotificationAlertStyle": "banner"
      }
    },
    "dmg": {
      "artifactName": "Bikorch.dmg",
      "title": "Bikorch"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    }
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.7",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
